generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AppAnalytics {
  id              Int      @id @default(autoincrement())
  shop            String   @unique
  views           Int      @default(0)
  arUses          Int      @default(0)
  totalStayTimeMs BigInt   @default(0)
  addCartCount    Int      @default(0)
  updatedAt       DateTime @updatedAt
}