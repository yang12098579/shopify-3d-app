// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // 🛡️ 商业级修复：从本地 sqlite 切换为商用级 postgresql 云数据库
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AppAnalytics {
  id              Int      @id @default(autoincrement())
  shop            String   @unique
  views           Int      @default(0)
  arUses          Int      @default(0)
  totalStayTimeMs BigInt   @default(0) // 采集真实 C 端买家累计停留时间
  addCartCount    Int      @default(0) // 采集真实加购转化率数据
  updatedAt       DateTime @updatedAt
}