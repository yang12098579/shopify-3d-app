generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AppAnalytics {
  id              Int      @id @default(autoincrement())
  shop            String   @unique
  views           Int      @default(0)
  arUses          Int      @default(0)
  totalStayTimeMs BigInt   @default(0)
  addCartCount    Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model RateLimit {
  shop        String
  windowStart String
  count       Int    @default(1)

  @@id([shop, windowStart])
}

model ConversionJob {
  id        String   @id
  productId String
  shop      String
  status    String   @default("pending")
  glbUrl    String
  usdzUrl   String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  message   String
  stack     String?
  shop      String?
  route     String?
  createdAt DateTime @default(now())
}

model DailyStats {
  id        Int      @id @default(autoincrement())
  shop      String
  date      String
  views     Int      @default(0)
  arUses    Int      @default(0)
  addCartCount Int   @default(0)
  stayTimeMs BigInt  @default(0)

  @@unique([shop, date])
}

model VariantModel {
  id        String   @id @default(uuid())
  shop      String
  productId String
  variantId String
  glbUrl    String
  usdzUrl   String?
  createdAt DateTime @default(now())

  @@unique([productId, variantId])
}

