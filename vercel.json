{
  "buildCommand": "npx prisma generate && npx react-router build",
  "installCommand": "npm ci",
  "framework": null,
  "outputDirectory": "build/client",
  "builds": [
    {
      "src": "build/server/index.js",
      "use": "@vercel/node",
      "config": {
        "memory": 512,
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/build/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/build/server/index"
    }
  ]
}